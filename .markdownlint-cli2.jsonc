{
  "config": ".markdownlint.json",
  "globs": ["**/*.md"],
  "ignores": [
    "**/node_modules/**",
    "**/dist/**",
    "**/out/**",
    "**/release/**",
    ".direnv/**",
    ".pnpm-store/**",
    "target/**",
    ".cache/**",
    "apps/unshell-mac/.build/**",
    "apps/unshell-mac/Vendor/**",
    "apps/unshell-desktop/src/renderer/dev/samples/**",
  ],
}
