{
  "overrides": [
    {
      "files": "*.md",
      "options": {
        "proseWrap": "always",
        "printWidth": 120
      }
    },
    {
      "files": "*.{ts,tsx,js,jsx,json}",
      "options": {
        "singleQuote": false,
        "plugins": ["@ianvs/prettier-plugin-sort-imports", "prettier-plugin-tailwindcss"],
        "importOrder": [
          "<BUILTIN_MODULES>",
          "",
          "<THIRD_PARTY_MODULES>",
          "",
          "^@routes/(.*)$",
          "",
          "^@guards/(.*)$",
          "",
          "^@stores/(.*)$",
          "",
          "^@contexts/(.*)$",
          "",
          "^@hooks/(.*)$",
          "",
          "^@utils/(.*)$",
          "",
          "^@pages/(.*)$",
          "",
          "^@features/(.*)$",
          "",
          "^@components/(.*)$",
          "",
          "^@icons/(.*)$",
          "",
          "^@app/(?!types/)(.*)$",
          "^@app/types/(.*)$",
          "",
          "<TYPES>",
          "",
          "^\\.\\/(.*)\\/components\\/|\\.\\.\\/components\\/.*$",
          "",
          "^\\.\\/(.*)\\/hooks\\/|\\.\\.\\/hooks\\/.*$",
          "",
          "^\\.\\/(.*)\\/utils\\/|\\.\\.\\/utils\\/.*$",
          "",
          "^..[./]",
          "",
          "^(?!.*.css$)[./]",
          "",
          "^[./]",
          "",
          "<TYPES>^[.]"
        ],
        "importOrderParserPlugins": ["typescript", "jsx", "decorators-legacy"]
      }
    }
  ]
}
