{
  "name": "unshell",
  "version": "0.1.0",
  "private": true,
  "description": "A development environment for people and agents",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm build:packages && concurrently --kill-others -n api,desktop \"pnpm dev:api\" \"pnpm dev:desktop\"",
    "dev:api": "pnpm --filter unshell-api dev",
    "dev:desktop": "pnpm --filter unshell-desktop dev",
    "cli": "pnpm --filter unshell-cli dev",
    "build:packages": "pnpm --filter \"./packages/*\" -r build",
    "build": "pnpm -r build",
    "check": "pnpm build:packages && pnpm -r check",
    "lint": "pnpm check && eslint . --max-warnings 0 && pnpm docs:lint",
    "test": "pnpm build:packages && vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:lint": "markdownlint-cli2",
    "release:check": "pnpm build && node scripts/check-release.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm test && pnpm release:check",
    "package:desktop": "pnpm build:packages && pnpm --filter unshell-desktop package",
    "test:desktop": "pnpm release:check && node --import tsx scripts/smoke-desktop.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "concurrently": "10.0.6",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "markdownlint-cli2": "0.18.1",
    "prettier": "3.7.3",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "playwright": "1.64.1"
  },
  "type": "module"
}
