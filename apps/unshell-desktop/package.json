{
  "name": "unshell-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Unshell desktop app",
  "author": "Unshell contributors",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "check": "tsc --noEmit",
    "package": "pnpm build && electron-builder --dir",
    "postinstall": "install-electron"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shiki": "4.6.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "dev.unshell.desktop",
    "productName": "Unshell",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dir"
      ]
    },
    "linux": {
      "category": "Development",
      "target": [
        "dir"
      ]
    },
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ]
  }
}
